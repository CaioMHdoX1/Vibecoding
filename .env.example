# Database (MySQL via Docker Compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=misho_bonsai
MYSQL_USER=misho_user
MYSQL_PASSWORD=mishopassword
MYSQL_PORT=3306

DATABASE_URL="mysql://misho_user:mishopassword@localhost:3306/misho_bonsai"

# API Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
JWT_ACCESS_SECRET=supersecretaccesskey_change_in_production
JWT_REFRESH_SECRET=supersecretrefreshkey_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web (Vite)
VITE_API_URL=http://localhost:3000/api/v1
